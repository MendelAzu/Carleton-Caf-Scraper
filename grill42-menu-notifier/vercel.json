{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "node_modules/@sparticuz/chromium/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "crons": [
    { "path": "/api/cron", "schedule": "1 15 * * *" },
    { "path": "/api/cron", "schedule": "1 16 * * *" },
    { "path": "/api/cron", "schedule": "31 20 * * *" },
    { "path": "/api/cron", "schedule": "31 21 * * *" }
  ]
}
